---
import {
  decodeSlug,
  getTerm,
} from "emdash";

import Base from "../../layouts/Base.astro";

import ProductCard from "../../modules/products/components/ProductCard.astro";

import {
  getProductsByCategory,
} from "../../modules/services/product.service";
import { getPublicEntrySlug, getRequestLocale, getRouteSlug, localizePath, useTranslations } from "../../i18n/ui";

const locale = getRequestLocale(Astro);
const t = useTranslations(locale);

const slug = decodeSlug(getRouteSlug(Astro));

const otherProductCategories = [
  { slug: "thanh-nep", label: t("nav.edgeProtector") },
  { slug: "bang-dinh", label: t("nav.adhesiveTape") },
];
const isOtherProductsArchive = slug === "san-pham-khac";

const category = isOtherProductsArchive
  ? { slug, label: t("nav.otherProducts") }
  : slug
  ? await getTerm("product_category", slug, { locale })
  : null;

if (!category) {
  return Astro.redirect(localizePath("/404", locale));
}

const requestedCategories = isOtherProductsArchive
  ? otherProductCategories
  : [{ slug: category.slug, label: category.label }];

const categoryResults = await Promise.all(
  requestedCategories.map(async (item) => ({
    ...item,
    result: await getProductsByCategory(item.slug, 100, locale),
  })),
);

const displayCategoryResults = isOtherProductsArchive
  ? categoryResults.toSorted(
      (first, second) =>
        second.result.entries.length - first.result.entries.length,
    )
  : categoryResults;

for (const { result } of categoryResults) {
  if (Astro.cache?.enabled) Astro.cache.set(result.cacheHint);
}

const productCount = categoryResults.reduce(
  (total, item) => total + item.result.entries.length,
  0,
);

for (const { slug: categorySlug, result } of categoryResults) {
  if (!result.error) continue;

  console.error(
    `Không thể tải danh mục sản phẩm ${categorySlug}:`,
    result.error,
  );
}
---

<Base
  title={category.label}
  description={t("products.categoryDescription", { name: category.label })}
>
  <main class="category-page">
    <!-- <a href="/" class="category-page__back">
      ← Quay lại trang chủ
    </a> -->

    {!isOtherProductsArchive && (
    <header class="category-page__header">
      <!-- <span class="category-page__eyebrow">
        Danh mục sản phẩm
      </span> -->

      <h1>{category.label}</h1>

      <p>
        {t("products.count", { count: productCount })}
      </p>
    </header>
    )}

    {
      displayCategoryResults.map(({ slug: categorySlug, label, result }) => (
        <section
          class:list={[
            "category-group",
            isOtherProductsArchive && "category-group--separated",
          ]}
          aria-labelledby={isOtherProductsArchive ? `category-${categorySlug}` : undefined}
        >
          {isOtherProductsArchive && (
            <header class="category-page__header category-group__header">
              <h2 id={`category-${categorySlug}`}>
                <a href={localizePath(`/product-category/${categorySlug}`, locale)}>
                  {label}
                </a>
              </h2>
              <p>{t("products.count", { count: result.entries.length })}</p>
            </header>
          )}

          {result.error ? (
            <p class="category-page__message">
              {t("products.loadError")}
            </p>
          ) : result.entries.length === 0 ? (
            <p class="category-page__message category-page__message--empty">
              {t("products.emptyCategory")}
            </p>
          ) : (
            <div class="category-page__grid">
              {result.entries.map((product) => (
                <ProductCard
                  title={product.data.title}
                  href={localizePath(`/products/${getPublicEntrySlug(product)}`, locale)}
                  featuredImage={product.data.featured_image}
                  featuredImageAlt={typeof product.data.featured_image_alt === "string" ? product.data.featured_image_alt.trim() : product.data.featured_image?.alt ?? product.data.title}
                />
              ))}
            </div>
          )}
        </section>
      ))
    }
  </main>
</Base>

<style>
  .category-page {
    width: min(
      var(--container),
      calc(100% - 32px)
    );
    margin: 0 auto;
    padding: 40px 0 64px;
  }

  .category-page__back {
    display: inline-flex;
    margin-bottom: 28px;
    color: #0878c1;
    text-decoration: none;
  }

  .category-page__back:hover {
    color: #075e96;
    text-decoration: underline;
  }

  .category-page__header {
    margin-bottom: 28px;
    padding-bottom: 20px;
    border-bottom: 1px solid #e5e7eb;
  }

  .category-page__eyebrow {
    display: block;
    margin-bottom: 6px;
    color: #0878c1;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .category-page__header h1,
  .category-group__header h2 {
    margin: 0 0 8px;
    color: inherit;
    font-size: clamp(
      30px,
      4vw,
      42px
    );
    font-weight: inherit;
    line-height: inherit;
    letter-spacing: inherit;
    text-transform: none;
  }

  .category-page__header p,
  .category-page__message {
    margin: 0;
    color: #64748b;
  }

  .category-group--separated + .category-group--separated {
    margin-top: 52px;
  }

  .category-group__header {
    margin-bottom: 28px;
  }

  .category-group__header h2 a {
    color: inherit;
    text-decoration: none;
  }

  .category-group__header h2 a:hover {
    color: #075e96;
  }

  .category-page__message--empty {
    padding: 24px;
    border: 1px solid #d7e0e8;
    border-radius: 4px;
    background: #fff;
  }

  .category-page__grid {
    display: grid;
    grid-template-columns:
      repeat(4, minmax(0, 292px));
    gap: 24px;
  }

  @media (max-width: 1050px) {
    .category-page__grid {
      grid-template-columns:
        repeat(3, minmax(0, 292px));
    }
  }

  @media (max-width: 780px) {
    .category-page__grid {
      grid-template-columns:
        repeat(2, minmax(0, 292px));
    }
  }

  @media (max-width: 520px) {
    .category-page {
      width: min(
        calc(100% - 24px),
        1200px
      );
      padding-top: 28px;
    }

    .category-page__grid {
      grid-template-columns:
        minmax(0, 292px);
      justify-content: center;
    }

    .category-group--separated + .category-group--separated {
      margin-top: 40px;
    }

  }
</style>
