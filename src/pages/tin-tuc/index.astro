---
import { Image } from "emdash/ui";

import Container from "../../components/common/Container.astro";
import Base from "../../layouts/Base.astro";
import { getCollectionWithFallback } from "../../i18n/content";
import {
  getRequestLocale,
  intlLocaleByUiLocale,
  localizePath,
  useTranslations,
} from "../../i18n/ui";
import { getCanonicalPostSlug } from "../../utils/content-slugs";

const locale = getRequestLocale(Astro);
const t = useTranslations(locale);

const { entries: posts, cacheHint } = await getCollectionWithFallback("posts", {
  status: "published",
  orderBy: { published_at: "desc" },
  locale,
});

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const formatDate = (date: Date) =>
  date.toLocaleDateString(intlLocaleByUiLocale[locale], {
    day: "2-digit",
    month: "2-digit",
    year: "numeric",
  });
---

<Base title={t("posts.news")} description={t("posts.metaDescription")}>
  <Container>
    <div class="posts-page">
      <header class="posts-page__header">
        <h1>{t("posts.news")}</h1>
        <p>{t("posts.count", { count: posts.length })}</p>
      </header>

      {
        posts.length === 0 ? (
          <p class="empty">{t("posts.empty")}</p>
        ) : (
          <div class="posts-list">
            {posts.map((post) => {
              const href = localizePath(
                `/tin-tuc/${getCanonicalPostSlug(post)}`,
                locale,
              );

              return (
                <article
                  class:list={[
                    "post-card",
                    !post.data.featured_image && "post-card--text-only",
                  ]}
                >
                  {post.data.featured_image && (
                    <a
                      href={href}
                      class="post-card__image"
                      aria-label={t("news.read", { title: post.data.title })}
                    >
                      <Image
                        image={post.data.featured_image}
                        alt={post.data.featured_image.alt ?? post.data.title}
                        width={720}
                        height={405}
                      />
                    </a>
                  )}

                  <a href={href} class="post-card__content">
                    {post.data.publishedAt && (
                      <time datetime={post.data.publishedAt.toISOString()}>
                        {formatDate(post.data.publishedAt)}
                      </time>
                    )}
                    <h2>{post.data.title}</h2>
                    {post.data.excerpt && <p>{post.data.excerpt}</p>}
                  </a>
                </article>
              );
            })}
          </div>
        )
      }
    </div>
  </Container>
</Base>

<style>
  .posts-page {
    padding-block: 40px 64px;
  }

  .posts-page__header {
    margin-bottom: 28px;
    padding-bottom: 20px;
    border-bottom: 1px solid #e5e7eb;
  }

  .posts-page__header h1 {
    margin: 0 0 8px;
    font-size: clamp(30px, 4vw, 42px);
    font-weight: inherit;
    line-height: inherit;
  }

  .posts-page__header p {
    margin: 0;
    color: #64748b;
  }

  .empty {
    color: var(--muted);
    font-size: 18px;
  }

  .posts-list {
    display: grid;
    gap: 18px;
  }

  .post-card {
    height: 240px;
    display: grid;
    grid-template-columns: minmax(300px, 38%) minmax(0, 1fr);
    overflow: hidden;
    border: 1px solid #d7e0e8;
    border-radius: 6px;
    background: #fff;
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }

  .post-card:hover {
    border-color: #9dc8e5;
    box-shadow: 0 10px 26px rgb(7 53 99 / 10%);
    transform: translateY(-2px);
  }

  .post-card--text-only {
    grid-template-columns: 1fr;
  }

  .post-card__image {
    display: block;
    height: 100%;
    overflow: hidden;
    background: #eaf2f8;
  }

  .post-card__image :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .post-card:hover .post-card__image :global(img) {
    transform: scale(1.025);
  }

  .post-card__content {
    min-width: 0;
    display: flex;
    padding: clamp(18px, 2vw, 26px);
    justify-content: flex-start;
    flex-direction: column;
    color: inherit;
    text-decoration: none;
  }

  .post-card__content time {
    color: var(--orange);
    font-size: 14px;
    font-weight: 700;
  }

  .post-card__content h2 {
    display: -webkit-box;
    min-height: 2.6em;
    margin: 8px 0 0;
    overflow: hidden;
    color: var(--blue-dark);
    font-size: clamp(20px, 2.2vw, 28px);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.02em;
    transition: color 0.2s ease;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .post-card__content:hover h2 {
    color: var(--blue);
  }

  .post-card__content p {
    display: -webkit-box;
    min-height: 3.3em;
    margin: 12px 0 0;
    overflow: hidden;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.65;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  @media (max-width: 820px) {
    .post-card {
      height: 190px;
      grid-template-columns: minmax(240px, 40%) minmax(0, 1fr);
    }

    .post-card__image {
      height: 100%;
    }

    .post-card__content {
      padding: 20px;
    }

    .post-card__content h2 {
      font-size: 20px;
    }
  }

  @media (max-width: 640px) {
    .posts-page {
      padding-block: 28px 48px;
    }

    .post-card,
    .post-card--text-only {
      height: auto;
      grid-template-columns: 1fr;
    }

    .post-card__image {
      height: auto;
      min-height: 0;
      aspect-ratio: 16 / 9;
    }

    .post-card__content {
      min-height: 180px;
      padding: 18px;
    }

    .post-card__content h2 {
      font-size: 19px;
    }

    .post-card__content p {
      font-size: 14px;
    }
  }
</style>
