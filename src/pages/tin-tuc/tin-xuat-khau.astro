---
import { Image } from "emdash/ui";
import Container from "../../components/common/Container.astro";
import PageHeading from "../../components/common/PageHeading.astro";
import BaseLayout from "../../layouts/Base.astro";
import { getRequestLocale, localizePath, useTranslations } from "../../i18n/ui";
import { getPostsByTaxonomy } from "../../modules/services/post.service";
import { getCanonicalPostSlug } from "../../utils/content-slugs";

const locale = getRequestLocale(Astro);
const t = useTranslations(locale);

const { entries: exportArticles, error, cacheHint } = await getPostsByTaxonomy(
  "category",
  "tin-xuat-khau",
  locale,
  50,
);

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
if (error) console.error("Không thể tải bài viết Tin xuất khẩu:", error);
---

<BaseLayout
  title={t("posts.exportTitle")}
  description={t("posts.exportDescription")}
>
  <Container>
    <article class="mx-auto max-w-5xl py-10 lg:py-14">
      <PageHeading eyebrow={t("posts.news")} title={t("posts.exportTitle")} />

      {exportArticles.length > 0 ? (
        <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {exportArticles.map((article) => (
            <article class="news-card">
              {article.data.featured_image && (
                <a
					href={localizePath(`/tin-tuc/${getCanonicalPostSlug(article)}`, locale)}
                  class="news-image"
                  aria-label={t("news.read", { title: article.data.title })}
                  {...article.edit.featured_image}
                >
                  <Image image={article.data.featured_image} />
                </a>
              )}

              <div class="news-body">
                <h3 {...article.edit.title}>
					<a href={localizePath(`/tin-tuc/${getCanonicalPostSlug(article)}`, locale)}>{article.data.title}</a>
                </h3>
                {article.data.excerpt && <p {...article.edit.excerpt}>{article.data.excerpt}</p>}
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="mt-10 rounded border border-slate-200 p-8 text-center text-slate-600">
          {t("posts.empty")}
        </div>
      )}
    </article>
  </Container>
</BaseLayout>
