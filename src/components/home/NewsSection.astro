---
import type { MediaValue } from "emdash";
import { Image } from "emdash/ui";
import Container from "../common/Container.astro";
import SectionHeading from "./SectionHeading.astro";
import { getRequestLocale, localizePath, useTranslations } from "../../i18n/ui";

interface NewsCardData {
  title: string;
  description?: string;
  image?: MediaValue;
  alt: string;
  href: string;
  date?: string;
}

interface Props {
  items: NewsCardData[];
}

const { items } = Astro.props;
const locale = getRequestLocale(Astro);
const t = useTranslations(locale);
const featuredItem = items[0];
const secondaryItems = items.slice(1);
---

<section class="news-section" id="tin-tuc">
  <Container>
    <SectionHeading title={t("news.title")} linkHref={localizePath("/tin-tuc", locale)} />

    {
      featuredItem ? (
        <div
          class:list={[
            "news-layout",
            { "news-layout--single": secondaryItems.length === 0 },
          ]}
        >
          <article
            class:list={[
              "news-card news-card--featured",
              { "news-card--text-only": !featuredItem.image },
            ]}
          >
            {featuredItem.image && (
              <a
                href={featuredItem.href}
                class="news-image"
                aria-label={t("news.read", { title: featuredItem.title })}
              >
                <Image
                  image={featuredItem.image}
                  alt={featuredItem.alt}
                  width={1000}
                  height={650}
                />
              </a>
            )}

            <div class="news-body">
              {featuredItem.date && <small>{featuredItem.date}</small>}
              <h3><a href={featuredItem.href}>{featuredItem.title}</a></h3>
              {featuredItem.description && <p>{featuredItem.description}</p>}
            </div>
          </article>

          {secondaryItems.length > 0 && (
            <div
              class="news-list"
              role="region"
              aria-label={t("news.title")}
              tabindex="0"
            >
              {secondaryItems.map((item) => (
                <article
                  class:list={[
                    "news-card news-card--compact",
                    { "news-card--text-only": !item.image },
                  ]}
                >
                  {item.image && (
                    <a
                      href={item.href}
                      class="news-image"
                      aria-label={t("news.read", { title: item.title })}
                    >
                      <Image
                        image={item.image}
                        alt={item.alt}
                        width={420}
                        height={280}
                      />
                    </a>
                  )}

                  <div class="news-body">
                    {item.date && <small>{item.date}</small>}
                    <h3><a href={item.href}>{item.title}</a></h3>
                    {item.description && <p>{item.description}</p>}
                  </div>
                </article>
              ))}
            </div>
          )}
        </div>
      ) : (
        <p class="news-empty">{t("news.empty")}</p>
      )
    }
  </Container>
</section>
