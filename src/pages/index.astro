---
import { getSiteSettings } from "emdash";

import Base from "../layouts/Base.astro";
import HeroCarousel from "../components/carousel/HeroCarousel.astro";
import ProductSection from "../components/home/ProductSection.astro";
import TrustStrip from "../components/home/TrustStrip.astro";
import CatalogueBanner from "../components/home/CatalogueBanner.astro";
import NewsSection from "../components/home/NewsSection.astro";

import type {
  ProductSectionData,
  ProductWithAlt,
} from "../modules/types/product.type";

import {
  productCategoryLabelKeys,
  productCategoryNavigationOrder,
} from "../data/navigation";
import { resolveBlogSiteIdentity } from "../utils/site-identity";
import { getCanonicalPostSlug } from "../utils/content-slugs";
import {
  DEFAULT_UI_LOCALE,
  getPublicEntrySlug,
  getRequestLocale,
  intlLocaleByUiLocale,
  localizePath,
  useTranslations,
} from "../i18n/ui";
import {
  getCollectionWithFallback,
  getTermsForEntriesWithFallback,
} from "../i18n/content";

const locale = getRequestLocale(Astro);
const t = useTranslations(locale);

const [productResult, defaultProductResult, postResult, settings] = await Promise.all([
  getCollectionWithFallback<"products", ProductWithAlt>("products", {
    status: "published",
    orderBy: {
      published_at: "desc",
    },
    limit: 50,
    locale,
  }),

  locale === DEFAULT_UI_LOCALE
    ? Promise.resolve(null)
    : getCollectionWithFallback<"products", ProductWithAlt>("products", {
        status: "published",
        orderBy: {
          published_at: "desc",
        },
        limit: 50,
        locale: DEFAULT_UI_LOCALE,
      }),

  getCollectionWithFallback("posts", {
    status: "published",
    orderBy: {
      published_at: "desc",
    },
    limit: 8,
    locale,
  }),

  getSiteSettings(),
]);


Astro.cache.set(productResult.cacheHint);
if (defaultProductResult) Astro.cache.set(defaultProductResult.cacheHint);
Astro.cache.set(postResult.cacheHint);

if (productResult.error) {
  console.error("Không thể tải sản phẩm từ EmDash:", productResult.error);
}

if (postResult.error) {
  console.error("Không thể tải tin tức từ EmDash:", postResult.error);
}

// A translated collection can be incomplete while editors are still working
// on it. Keep every default-locale product on localized homepages, replacing a
// Vietnamese item with its translated version whenever the same slug exists.
const productEntries = defaultProductResult
  ? (() => {
      const localizedBySlug = new Map(
        productResult.entries.map((entry) => [getPublicEntrySlug(entry), entry]),
      );
      const defaultSlugs = new Set(
        defaultProductResult.entries.map((entry) => getPublicEntrySlug(entry)),
      );

      return [
        ...defaultProductResult.entries.map(
          (entry) => localizedBySlug.get(getPublicEntrySlug(entry)) ?? entry,
        ),
        ...productResult.entries.filter(
          (entry) => !defaultSlugs.has(getPublicEntrySlug(entry)),
        ),
      ];
    })()
  : productResult.entries;

const categoryTermsByProduct = await getTermsForEntriesWithFallback(
  "products",
  productEntries.map((product) => product.data.id),
  "product_category",
  locale,
);

const sectionsBySlug = new Map<string, ProductSectionData>();

for (const entry of productEntries) {
  const categories = categoryTermsByProduct.get(entry.data.id) ?? [];

  for (const category of categories) {
    const existingSection = sectionsBySlug.get(category.slug);
    const categoryLabelKey = productCategoryLabelKeys.get(category.slug);

    const section: ProductSectionData = existingSection ?? {
      id: category.slug,
      title: categoryLabelKey ? t(categoryLabelKey) : category.label,
      products: [],
    };

    section.products.push({
      name: entry.data.title,
      image: entry.data.featured_image,
      alt:
        typeof entry.data.featured_image_alt === "string"
          ? entry.data.featured_image_alt.trim()
          : entry.data.featured_image?.alt ?? entry.data.title,
      href: localizePath(`/products/${getPublicEntrySlug(entry)}`, locale),
    });

    sectionsBySlug.set(category.slug, section);
  }
}

const categoryOrder = new Map(
  productCategoryNavigationOrder.map((slug, index) => [slug, index]),
);

const displaySections = Array.from(sectionsBySlug.values())
  .sort((firstSection, secondSection) => {
    const firstIndex = categoryOrder.get(firstSection.id);
    const secondIndex = categoryOrder.get(secondSection.id);

    if (firstIndex === undefined && secondIndex === undefined) return 0;
    if (firstIndex === undefined) return 1;
    if (secondIndex === undefined) return -1;

    return firstIndex - secondIndex;
  })
  .map((section, index) => ({
    ...section,
    alternate: index % 2 === 1,
  }));

const cmsNews = postResult.entries.map((post) => ({
  title: post.data.title,
  description: post.data.excerpt,
  image: post.data.featured_image,
  alt: post.data.featured_image?.alt ?? post.data.title,
  href: localizePath(`/tin-tuc/${getCanonicalPostSlug(post)}`, locale),
  date: post.data.publishedAt?.toLocaleDateString(intlLocaleByUiLocale[locale], {
    day: "2-digit",
    month: "2-digit",
    year: "numeric",
  }),
}));

const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settings);
---

<Base title={`${siteTitle} | ${t("seo.homeTitle")}`} description={siteTagline}>
  <HeroCarousel />

  {
    displaySections
      .slice(0, 3)
      .map((section) => <ProductSection section={section} />)
  }

  <TrustStrip />

  {
    displaySections
      .slice(3)
      .map((section) => <ProductSection section={section} />)
  }

  <CatalogueBanner />

  <NewsSection items={cmsNews} />
</Base>
