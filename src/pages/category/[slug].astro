---
import {
	getTerm,
	decodeSlug,
} from "emdash";
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import { getReadingTime } from "../../utils/reading-time";
import { getRequestLocale, getRouteSlug, localizePath, useTranslations } from "../../i18n/ui";
import { getTermsForEntriesWithFallback } from "../../i18n/content";
import { getPostsByTaxonomy } from "../../modules/services/post.service";
import { getCanonicalPostSlug } from "../../utils/content-slugs";

const locale = getRequestLocale(Astro);
const t = useTranslations(locale);

const slug = decodeSlug(getRouteSlug(Astro));
const term = slug ? await getTerm("category", slug, { locale }) : null;

if (!term) {
	return Astro.redirect(localizePath("/404", locale));
}

const { entries: posts, cacheHint } = await getPostsByTaxonomy(
	"category",
	term.slug,
	locale,
);

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// Single batched query for tags on every post in this category, rather
// than calling getEntryTerms() per post (which would be one round-trip
// per post).
const tagsByEntry = await getTermsForEntriesWithFallback(
	"posts",
	posts.map((p) => p.data.id),
	"tag",
	locale,
);
const filteredPosts = posts.map((post) => ({
	post,
	tags: tagsByEntry.get(post.data.id) ?? [],
}));
---

<Base title={term.label} description={t("taxonomy.categoryDescription", { name: term.label })}>
	<section class="archive-section">
		<header class="archive-header">
			<span class="archive-label">{t("taxonomy.category")}</span>
			<h1 class="archive-title">{term.label}</h1>
			<p class="archive-count">
				{t("taxonomy.postCount", { count: filteredPosts.length })}
			</p>
		</header>

		{
			filteredPosts.length === 0 ? (
				<p class="no-posts">{t("taxonomy.emptyCategory")}</p>
			) : (
				<div class="posts-grid">
					{filteredPosts.map(({ post, tags }) => (
						<PostCard
							title={post.data.title}
							excerpt={post.data.excerpt}
							featuredImage={post.data.featured_image}
							href={localizePath(`/tin-tuc/${getCanonicalPostSlug(post)}`, locale)}
							date={post.data.publishedAt ?? undefined}
							readingTime={getReadingTime(post.data.content)}
							tags={tags.map((t) => ({ slug: t.slug, label: t.label }))}
						/>
					))}
				</div>
			)
		}
	</section>
</Base>

<style>
	.archive-section {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-12) var(--spacing-6);
	}

	.archive-header {
		margin-bottom: var(--spacing-12);
		padding-bottom: var(--spacing-8);
		border-bottom: 1px solid var(--color-border-subtle);
	}

	.archive-label {
		display: block;
		font-size: var(--font-size-xs);
		font-weight: 500;
		color: var(--color-brand);
		text-transform: uppercase;
		letter-spacing: var(--tracking-wider);
		margin-bottom: var(--spacing-2);
	}

	.archive-title {
		font-size: var(--font-size-4xl);
		font-weight: var(--font-weight-display);
		letter-spacing: var(--tracking-tight);
		margin-bottom: var(--spacing-2);
	}

	.archive-count {
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}

	.posts-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--spacing-12) var(--spacing-8);
	}

	.no-posts {
		color: var(--color-muted);
	}

	@media (max-width: 900px) {
		.posts-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 600px) {
		.posts-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
