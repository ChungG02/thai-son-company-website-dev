---
import ContactInformation from "../components/about/ContactInformation.astro";
import Container from "../components/common/Container.astro";
import PageHeading from "../components/common/PageHeading.astro";
// import LocationCard from "../components/contact/LocationCard.astro";
import MapSection from "../components/contact/MapSection.astro";
import SocialChannels from "../components/contact/SocialChannels.astro";
import BaseLayout from "../layouts/Base.astro";

import {
  // companyLocations,
  contactSummary,
  mapLocations,
  socialMedia,
} from "../data/contact";
---

<BaseLayout
  title="Liên hệ Thái Sơn Plastic"
  description="Thông tin liên hệ, văn phòng, nhà máy và các kênh truyền thông của Công ty TNHH Thái Sơn."
>
  <Container>
    <div class="py-10 lg:py-14">
      <PageHeading title="Liên hệ Thái Sơn Plastic" />

      <div class="mt-10">
        <!-- <h2
          class="mb-7 text-2xl font-bold uppercase text-slate-900
                 sm:text-3xl"
        >
          Công ty Thái Sơn
        </h2> -->

        <ContactInformation items={contactSummary} title="Thông tin công ty" />
      </div>

      <!-- <section class="mt-12" aria-labelledby="company-locations-title"> -->
        <!-- <h2
          id="company-locations-title"
          class="mb-6 text-2xl font-bold text-slate-800"
        >
          Văn phòng và nhà máy
        </h2> -->

        <!-- <div class="grid gap-x-12 gap-y-14 md:grid-cols-2 lg:grid-cols-3">
          {
            companyLocations.map((location) => (
              <LocationCard location={location} />
            ))
          }
        </div>
      </section> -->

      <div class="mt-12 grid items-start gap-10 lg:grid-cols-2">
        <MapSection locations={mapLocations} />
        <SocialChannels facebookPageUrl={socialMedia.facebookPageUrl} />
      </div>
    </div>
  </Container>
</BaseLayout>
