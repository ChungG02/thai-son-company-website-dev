---
import { decodeSlug, getSeoMeta, getSiteSettings } from "emdash";
// import type { Product } from "../../../.emdash/types";
import type { ProductWithAlt } from "../../modules/types/product.type";
import ProductGallery from "../../modules/products/components/ProductGallery.astro";
import Base from "../../layouts/Base.astro";
import ProductDescription from "../../modules/products/components/ProductDescription.astro";
import ProductSpecifications from "../../modules/products/components/ProductSpecifications.astro";
import { getPublicEntrySlug, getRequestLocale, getRouteSlug, localizePath, useTranslations } from "../../i18n/ui";
import { getEntryWithFallback } from "../../i18n/content";
import { resolveBlogSiteIdentity } from "../../utils/site-identity";

const locale = getRequestLocale(Astro);
const t = useTranslations(locale);

const slug = decodeSlug(getRouteSlug(Astro)); // Supports localized rewrites too.

if (!slug) {
  return Astro.redirect(localizePath("/404", locale));
}

const {
  entry: product,
  error,
  cacheHint,
} = await getEntryWithFallback<"products", ProductWithAlt>("products", slug, locale);

if (error) {
  console.error("Không thể/đọc được sản phẩm:", error);

  return new Response(t("products.loadError"), {
    status: 500,
  });
}

if (!product) {
  return Astro.redirect(localizePath("/404", locale));
}

if (Astro.cache?.enabled) {
  Astro.cache.set(cacheHint);
}

const { siteTitle } = resolveBlogSiteIdentity(await getSiteSettings());
const seo = getSeoMeta(product, {
  siteTitle,
  siteUrl: Astro.url.origin,
  path: localizePath(`/products/${getPublicEntrySlug(product)}`, locale),
  defaultOgImage: product.data.featured_image?.src,
});
---

<Base
  title={seo.title}
  pageTitle={seo.ogTitle}
  description={seo.description ?? t("products.metaDescription", { title: product.data.title })}
  image={seo.ogImage}
  canonical={seo.canonical}
  robots={seo.robots}
  content={{ collection: "products", id: product.data.id, slug: getPublicEntrySlug(product) }}
>
  <main class="product-detail">
    <a href={localizePath("/", locale)} class="back-link">← {t("products.back")}</a>

    <section class="product-detail__main">
      <ProductGallery
        title={product.data.title}
        featuredImage={product.data.featured_image}
        featuredImageAlt={typeof product.data.featured_image_alt === "string" ? product.data.featured_image_alt.trim() : product.data.featured_image?.alt ?? product.data.title}
        galleryImages={product.data.gallery_images}
      />

      <div class="product-detail__information">
        <p class="product-detail__label">{t("products.product")}</p>

        <h1 class="product-detail__title">
          {product.data.title}
        </h1>

        <ProductSpecifications
          origin={product.data.origin}
          availability={product.data.availability}
          sizes={product.data.sizes}
        />
      </div>
    </section>
    <ProductDescription description={product.data.description} />
  </main>
</Base>

<style>
  .product-detail {
    max-width: 1200px;
    min-height: 500px;
    margin: 0 auto;
    padding: 48px 24px;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 32px;
    color: var(--navy);
    text-decoration: none;
  }

  .back-link:hover {
    text-decoration: underline;
  }

  .product-detail__main {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 48px;
    align-items: start;
  }

  .product-detail__information {
    padding-top: 16px;
  }

  .product-detail__label {
    margin: 0 0 8px;
    color: #6b7280;
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
  }

  .product-detail__title {
    margin: 0;
    font-size: 42px;
    line-height: 1.2;
  }

  @media (max-width: 768px) {
    .product-detail {
      padding: 32px 16px;
    }

    .product-detail__main {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .product-detail__title {
      font-size: 32px;
    }
  }
</style>
