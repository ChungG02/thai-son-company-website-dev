---
import { Image } from "emdash/ui";
import Container from "../../components/common/Container.astro";
import PageHeading from "../../components/common/PageHeading.astro";
import BaseLayout from "../../layouts/Base.astro";
import { getRequestLocale, localizePath, useTranslations } from "../../i18n/ui";
import { getPostsByTaxonomy } from "../../modules/services/post.service";
import { getCanonicalPostSlug } from "../../utils/content-slugs";

const locale = getRequestLocale(Astro);
const t = useTranslations(locale);

const { entries: recruitmentPosts, error, cacheHint } = await getPostsByTaxonomy(
  "category",
  "tuyen-dung",
  locale,
  50,
);

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
if (error) console.error("Không thể tải bài viết Tuyển dụng:", error);
---

<BaseLayout
  title={t("posts.recruitmentTitle")}
  description={t("posts.recruitmentDescription")}
>
  <Container>
    <article class="mx-auto max-w-5xl py-10 lg:py-14">
      <PageHeading eyebrow={t("posts.careers")} title={t("posts.recruitmentTitle")} />

      {recruitmentPosts.length > 0 ? (
        <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {recruitmentPosts.map((post) => (
            <article class="news-card">
              {post.data.featured_image && (
                <a
					href={localizePath(`/tin-tuc/${getCanonicalPostSlug(post)}`, locale)}
                  class="news-image"
                  aria-label={t("news.read", { title: post.data.title })}
                  {...post.edit.featured_image}
                >
                  <Image image={post.data.featured_image} />
                </a>
              )}

              <div class="news-body">
                <h3 {...post.edit.title}>
					<a href={localizePath(`/tin-tuc/${getCanonicalPostSlug(post)}`, locale)}>{post.data.title}</a>
                </h3>
                {post.data.excerpt && <p {...post.edit.excerpt}>{post.data.excerpt}</p>}
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="mt-10 rounded border border-slate-200 p-8 text-center text-slate-600">
          {t("posts.empty")}
        </div>
      )}
    </article>
  </Container>
</BaseLayout>
