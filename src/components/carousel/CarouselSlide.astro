---
import type { HeroSlide } from "../../data/heroSlides";
import { useTranslations, type UiLocale } from "../../i18n/ui";

interface Props {
  slide: HeroSlide;
  index: number;
  locale: UiLocale;
  isActive?: boolean;
}

const { slide, index, locale, isActive = false } = Astro.props;
const t = useTranslations(locale);
const alt = t(slide.altKey);
---

<div
  data-carousel-slide
  data-index={index}
  class:list={["carousel-slide", isActive && "is-active"]}
  role="group"
  aria-roledescription="slide"
  aria-label={`Slide ${index + 1}`}
  aria-hidden={!isActive}
  data-layout={slide.layout}
>
  <img
    class="hero-background"
    src={slide.image}
    alt=""
    width="2048"
    height="682"
    loading={index === 0 ? "eager" : "lazy"}
    fetchpriority={index === 0 ? "high" : "auto"}
    decoding="async"
    draggable={false}
  />

  <div class="hero-copy">
    {
      index === 0 ? (
        <h1 class="hero-headline">
          {slide.headlineKeys.map((key, lineIndex) => (
            <span class:list={["hero-headline-line", `line-${lineIndex + 1}`]}>
              {t(key)}
            </span>
          ))}
        </h1>
      ) : (
        <div class="hero-headline" role="presentation">
          {slide.headlineKeys.map((key, lineIndex) => (
            <span class:list={["hero-headline-line", `line-${lineIndex + 1}`]}>
              {t(key)}
            </span>
          ))}
        </div>
      )
    }

    {slide.subheadingKey && (
      <p class="hero-subheading">{t(slide.subheadingKey)}</p>
    )}

    {slide.productLabelKeys && (
      <div class="hero-product-labels">
        {slide.productLabelKeys.map((key) => <span>{t(key)}</span>)}
      </div>
    )}

    {slide.benefits && (
      <div class="hero-benefits">
        {slide.benefits.map((benefit) => (
          <div class="hero-benefit">
            <strong>{t(benefit.titleKey)}</strong>
            {benefit.descriptionKey && <span>{t(benefit.descriptionKey)}</span>}
          </div>
        ))}
      </div>
    )}

    {slide.footerKey && <p class="hero-footer-copy">{t(slide.footerKey)}</p>}
  </div>

  {slide.href && (
    <a class="carousel-slide-link" href={slide.href} aria-label={alt}>
      <span class="visually-hidden">{alt}</span>
    </a>
  )}
</div>
