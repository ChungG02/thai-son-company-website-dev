---
import CompanyOverview from "../components/about/CompanyOverview.astro";
import Container from "../components/common/Container.astro";
import PageHeading from "../components/common/PageHeading.astro";
import BaseLayout from "../layouts/Base.astro";
// import ContactInformation from "../components/about/ContactInformation.astro";

import { companyProfile } from "../data/companyProfile";
---

<BaseLayout
  title="Giới thiệu Công ty Thái Sơn Plastic"
  description="Giới thiệu về Công ty TNHH Thái Sơn và các giải pháp vật tư đóng gói công nghiệp."
>
  <Container>
    <article class="mx-auto max-w-5xl py-10 lg:py-14">
      <PageHeading
        eyebrow="Giới thiệu về chúng tôi"
        eyebrowClass="text-base sm:text-lg"
        title="Giới thiệu Công ty TNHH Sản xuất Thương mại và Xuất nhập khẩu Thái Sơn"
      />

      <div class="mt-10">
        <h2
          id="company-overview-title"
          class="mb-7 text-xl font-bold uppercase text-[#1477b9]
                 sm:text-2xl"
        >
          Tổng quan công ty
        </h2>

        <CompanyOverview items={companyProfile.overview} />
      </div>

      <section
        class="mt-10"
        aria-labelledby="about-us-title"
      >
        <h2
          id="about-us-title"
          class="mb-5 text-xl font-bold uppercase text-[#2589bd]"
        >
          Về chúng tôi
        </h2>

        <div class="space-y-10 text-base leading-7 text-slate-700">
          {
            companyProfile.introduction.map((section) => (
              <section aria-labelledby={section.title ? section.id : undefined}>
                {section.title && (
                  <h3
                    id={section.id}
                    class:list={[
                      "text-lg font-bold text-[#1477b9] sm:text-xl",
                      section.details ? "mb-6" : "mb-4",
                    ]}
                  >
                    {section.title}
                  </h3>
                )}

                {section.details && (
                  <dl class="mb-5 space-y-3 border-l-4 border-[#1477b9] bg-slate-50 px-5 py-4">
                    {section.details.map((item) => (
                      <div class="grid gap-1 sm:grid-cols-[170px_minmax(0,1fr)] sm:gap-5">
                        <dt class="font-semibold text-slate-900">{item.label}:</dt>
                        <dd
                          class:list={[
                            "m-0",
                            { "font-bold text-slate-900": item.emphasizeValue },
                          ]}
                        >
                          {item.value}
                        </dd>
                      </div>
                    ))}
                  </dl>
                )}

                {section.highlight && (
                  <p class="mb-4 font-bold text-slate-900">{section.highlight}</p>
                )}

                {section.paragraphs?.map((paragraph) => (
                  <p class="mt-4">
                    {typeof paragraph === "string" ? (
                      paragraph
                    ) : (
                      <>
                        {paragraph.before}
                        <strong class="font-bold text-slate-900">
                          {paragraph.emphasis}
                        </strong>
                        {paragraph.after}
                      </>
                    )}
                  </p>
                ))}

                {section.bullets && (
                  <ul class="mt-4 space-y-2.5">
                    {section.bullets.map((item) => (
                      <li class="flex gap-3">
                        <span
                          class="mt-[0.65rem] size-1.5 shrink-0 rounded-full bg-[#1477b9]"
                          aria-hidden="true"
                        />
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                )}
              </section>
            ))
          }
        </div>

        <blockquote
          class="mt-7 border-l-4 border-[#1477b9] bg-slate-50
                 px-5 py-4 text-slate-800"
        >
          <span class="font-semibold">
            Phương châm hoạt động:
          </span>

          <span class="ml-1 font-bold italic">
            “{companyProfile.motto}”.
          </span>
        </blockquote>
      </section>

      <figure class="mt-10 overflow-hidden rounded-sm bg-slate-100">
        <img
          src={companyProfile.factoryImage}
          alt="Hoạt động sản xuất vật tư đóng gói của Công ty Thái Sơn"
          width="2048"
          height="683"
          loading="lazy"
          decoding="async"
          class="aspect-3/1 w-full object-cover"
        />

        <figcaption
          class="border-t border-slate-200 bg-white px-4 py-3
                 text-center text-sm text-slate-500"
        >
          Hoạt động sản xuất và cung cấp vật tư đóng gói
        </figcaption>
      </figure>

      <section
        class="mt-10"
        aria-labelledby="products-title"
      >
        <h2
          id="products-title"
          class="mb-5 text-xl font-bold uppercase text-[#2589bd]"
        >
          Sản phẩm chính
        </h2>

        <ul class="grid gap-3 sm:grid-cols-2">
          {
            companyProfile.products.map((product) => (
              <li
                class="flex items-center gap-3 border border-slate-200
                       bg-white px-4 py-3 text-slate-700"
              >
                <span
                  class="flex size-6 shrink-0 items-center justify-center
                         rounded-full bg-[#1477b9] text-white"
                  aria-hidden="true"
                >
                  <svg
                    viewBox="0 0 20 20"
                    fill="currentColor"
                    class="size-4"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M16.704 5.292a1 1 0 0 1 .004 1.414l-8 8.05a1 1 0 0 1-1.42 0l-4-4.025a1 1 0 1 1 1.42-1.41L8 12.63l7.296-7.334a1 1 0 0 1 1.408-.004Z"
                      clip-rule="evenodd"
                    />
                  </svg>
                </span>

                {product}
              </li>
            ))
          }
        </ul>
      </section>

      <div class="mt-10">
  <!-- <ContactInformation items={companyProfile.contact} /> -->
</div>
    </article>
  </Container>
</BaseLayout>
